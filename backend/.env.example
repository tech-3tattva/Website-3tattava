# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Public URL for uploaded files (no trailing slash) — must match where /uploads is served
PUBLIC_UPLOAD_BASE_URL=http://localhost:5000

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>

# JWT Auth (customers)
JWT_SECRET=<64-char-random-secret-for-customers>
JWT_EXPIRES_IN=15m
REFRESH_SECRET=<64-char-random-secret-for-refresh>
REFRESH_EXPIRES_IN=30d

# JWT Auth (admin)
ADMIN_JWT_SECRET=<64-char-random-secret-for-admins>
ADMIN_JWT_EXPIRES_IN=8h

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# AWS (optional for local testing)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_BUCKET=3tattva-products
AWS_SES_FROM_EMAIL=oraders@3tattva.com

# 3TATTAVA Chatbot (Claude / Anthropic API)
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5-20251001

# =============================================================================
# NIMBUSPOST SHIPPING INTEGRATION
# =============================================================================
# Get from: NimbusPost Seller Panel → Settings → API → Generate API Key
# OR use email + password for Bearer-token login
NP_EMAIL=your-nimbuspost-seller@email.com
NP_PASSWORD=your-nimbuspost-password
# Warehouse name as saved in NimbusPost Seller Panel → Pickup Addresses
# Must match exactly (max 20 chars). Example: "warehouse 1"
NP_WAREHOUSE_NAME=warehouse 1

# =============================================================================
# INFLUENCER REFERRAL / PROMO CODE SYSTEM
# =============================================================================
# Razorpay webhook secret:
# Dashboard → Settings → Webhooks → [your webhook] → Secret
# Already listed above — make sure RAZORPAY_WEBHOOK_SECRET is set
# (same secret used for HMAC-SHA256 verification on /api/webhooks/razorpay)

# =============================================================================
# WHATSAPP NOTIFICATIONS (n8n + Green API)
# =============================================================================
# Your Railway-hosted n8n instance webhook URL for leads
N8N_LEAD_WEBHOOK_URL=https://your-n8n.railway.app/webhook/leads

# n8n webhook for influencer goal-reached notifications
N8N_INFLUENCER_WEBHOOK=https://your-n8n.railway.app/webhook/influencer-goal

# Green API credentials (paid plan required; Developer = only 3 chats/month)
# Get from: https://green-api.com → Account → Instances
GREEN_API_ID=1234567890
GREEN_API_TOKEN=abcdef1234567890abcdef1234567890abcdef1234567890

# =============================================================================
# CASHFREE PAYMENT GATEWAY  (replaces Razorpay)
# =============================================================================
# Get from: Cashfree Merchant Dashboard -> Developers -> API Keys
#   Test env: keys are auto-generated (Sandbox)
#   Live env: click "Generate API Keys" + complete 2FA (Production)
CASHFREE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxx
CASHFREE_CLIENT_SECRET=cfsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SANDBOX while testing, PRODUCTION when live
CASHFREE_ENVIRONMENT=SANDBOX
# Webhook secret: Dashboard -> Developers -> Webhooks. For PG this is usually the
# Secret Key; leave blank to reuse CASHFREE_CLIENT_SECRET for HMAC verification.
CASHFREE_WEBHOOK_SECRET=
# Public SDK mode used by the frontend checkout ("sandbox" or "production")
NEXT_PUBLIC_CASHFREE_MODE=sandbox

# =============================================================================
# VELOCITY SHIPPING  (replaces NimbusPost) — dashboard.velocity.in
# =============================================================================
# Get from: Velocity Dashboard -> Shipping -> Settings -> API / Integrations.
# IMPORTANT: also share Velocity's API documentation so the exact endpoints,
# auth header and payload shape can be wired (their API is not public).
VELOCITY_API_BASE_URL=https://api.velocity.in
VELOCITY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VELOCITY_WEBHOOK_SECRET=
# Pickup / warehouse location exactly as registered in the Velocity dashboard
VELOCITY_PICKUP_LOCATION=warehouse 1
VELOCITY_PICKUP_PINCODE=110032

# =============================================================================
# VAIDYACONNECT — ONLINE CONSULTATION (Google Meet + notifications)
# =============================================================================
# Where booking notifications for Dr. Falguni are sent (overrides the doctor
# record). Set this to her real inbox so she receives every consultation.
CONSULT_NOTIFY_EMAIL=falguni@example.com
#
# Unique Google Meet link per booking + auto Calendar invites to patient+doctor.
# One-time setup:  node scripts/authorize-google-calendar.js  (see that file).
# Needs GOOGLE_CLIENT_ID (above) + GOOGLE_CLIENT_SECRET + the refresh token below.
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALENDAR_REFRESH_TOKEN=
# Calendar that owns the events (default "primary" = the authorized account's).
GOOGLE_CALENDAR_ID=primary
# IANA timezone used to place slot times on the calendar.
CONSULT_TIMEZONE=Asia/Kolkata
#
# Fallback ONLY (used when the Calendar integration above is not configured):
# a single fixed Google Meet room reused for every consultation. Leave blank to
# fall back to an auto-generated Jitsi room instead.
CONSULT_MEET_LINK=
