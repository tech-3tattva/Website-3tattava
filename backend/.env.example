# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Public URL for uploaded files (no trailing slash) — must match where /uploads is served
PUBLIC_UPLOAD_BASE_URL=http://localhost:5000

# MongoDB
MONGODB_URI=mongodb+srv://9qHAKrP0N7S4xCY5:<9qHAKrP0N7S4xCY5>@3txxxxxxxxxxxxxxxx

# JWT Auth (customers)
JWT_SECRET=<64-char-random-secret-for-customers>
JWT_EXPIRES_IN=15m
REFRESH_SECRET=<64-char-random-secret-for-refresh>
REFRESH_EXPIRES_IN=30d

# JWT Auth (admin)
ADMIN_JWT_SECRET=<64-char-random-secret-for-admins>
ADMIN_JWT_EXPIRES_IN=8h

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# AWS (optional for local testing)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_BUCKET=3tattva-products
AWS_SES_FROM_EMAIL=oraders@3tattva.com

# 3TATTAVA Chatbot (Claude / Anthropic API)
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5-20251001

# =============================================================================
# NIMBUSPOST SHIPPING INTEGRATION
# =============================================================================
# Get from: NimbusPost Seller Panel → Settings → API → Generate API Key
# OR use email + password for Bearer-token login
NP_EMAIL=your-nimbuspost-seller@email.com
NP_PASSWORD=your-nimbuspost-password
# Warehouse name as saved in NimbusPost Seller Panel → Pickup Addresses
# Must match exactly (max 20 chars). Example: "warehouse 1"
NP_WAREHOUSE_NAME=warehouse 1

# =============================================================================
# INFLUENCER REFERRAL / PROMO CODE SYSTEM
# =============================================================================
# Razorpay webhook secret:
# Dashboard → Settings → Webhooks → [your webhook] → Secret
# Already listed above — make sure RAZORPAY_WEBHOOK_SECRET is set
# (same secret used for HMAC-SHA256 verification on /api/webhooks/razorpay)

# =============================================================================
# WHATSAPP NOTIFICATIONS (n8n + Green API)
# =============================================================================
# Your Railway-hosted n8n instance webhook URL for leads
N8N_LEAD_WEBHOOK_URL=https://your-n8n.railway.app/webhook/leads

# n8n webhook for influencer goal-reached notifications
N8N_INFLUENCER_WEBHOOK=https://your-n8n.railway.app/webhook/influencer-goal

# Green API credentials (paid plan required; Developer = only 3 chats/month)
# Get from: https://green-api.com → Account → Instances
GREEN_API_ID=1234567890
GREEN_API_TOKEN=abcdef1234567890abcdef1234567890abcdef1234567890
